LLM_API_KEY=your-provider-api-key
LLM_BASE_URL=http://host.docker.internal:20128/v1
LLM_MODEL=cx/gpt-6-luna
FLOWCHECK_AI_APPROVED_USER_IDS=
FLOWCHECK_AI_DAILY_PROVIDER_CALLS=30
FLOWCHECK_AI_PROVIDER_CONCURRENCY_PER_USER=1
FLOWCHECK_AI_PROVIDER_CONCURRENCY_GLOBAL=2
FLOWCHECK_AI_DAILY_EXECUTIONS=10
FLOWCHECK_AI_EXECUTION_CONCURRENCY_PER_USER=1
FLOWCHECK_AI_EXECUTION_CONCURRENCY_GLOBAL=2
FLOWCHECK_AI_PROVIDER_LEASE_SECONDS=600
FLOWCHECK_AI_EXECUTION_LEASE_SECONDS=600
FLOWCHECK_AI_LEASE_RENEWAL_SECONDS=30
FLOWCHECK_COOKIE_SECURE=false
FLOWCHECK_TRUSTED_TEST_ORIGINS=http://flowcheck-demo-target.test,http://flowcheck-healthy.test,http://flowcheck-buggy.test
YOUR_DOMAIN=localhost
